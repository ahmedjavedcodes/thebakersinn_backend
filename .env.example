DATABASE_URL=postgresql+asyncpg://bakers_inn_app:CHANGE_ME@localhost:5432/bakers_inn
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# App-wide password pepper, kept out of the DB. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PASSWORD_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_STRING
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
IMAGE_STORAGE=local
UPLOAD_DIR=./static/uploads
MAX_UPLOAD_MB=5
ENVIRONMENT=development

# Admin login (single shared admin account, seeded on first run)
ADMIN_EMAIL=owner@thebakersinn.com
ADMIN_PASSWORD=CHANGE_ME
